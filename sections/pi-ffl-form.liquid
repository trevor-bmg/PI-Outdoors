{{ 'pi-base.css' | asset_url | stylesheet_tag }}
{{ 'section-pi-rental-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pi-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bg = section.settings.background_color
  assign is_dark = false
  if bg == 'deep-blue' or bg == 'midnight'
    assign is_dark = true
  endif
-%}

<section
  class="pi-section pi-rental-form-section pi-rental-form-section--bg-{{ bg }}{% if is_dark %} pi-rental-form-section--dark{% endif %}"
  id="{{ section.settings.anchor_id | default: 'ffl-transfer-form' }}"
>
  <div class="pi-section__inner pi-section__inner--narrow">

    {%- if section.settings.label != blank -%}
      <span class="pi-label pi-reveal">{{ section.settings.label }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pi-heading pi-heading--h2 pi-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.label != blank -%}
      <hr class="pi-divider pi-reveal">
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="pi-body pi-rental-form__intro pi-reveal">{{ section.settings.body_text }}</div>
    {%- endif -%}

    {%- if section.settings.show_resource_links -%}
      <div class="pi-rental-form__resources pi-reveal">
        <strong>Helpful resources:</strong>
        <ul>
          {%- if section.settings.dnr_link != blank -%}
            <li><a href="{{ section.settings.dnr_link }}" target="_blank" rel="noopener">SC DNR Hunting Regulations</a></li>
          {%- endif -%}
          {%- if section.settings.atf_link != blank -%}
            <li><a href="{{ section.settings.atf_link }}" target="_blank" rel="noopener">ATF Firearm Transfer Information</a></li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    {%- form 'contact', id: 'PiFflForm', class: 'pi-rental-form pi-reveal' -%}
      <input type="hidden" name="contact[Form Type]" value="FFL Transfer Request">

      {%- if form.posted_successfully? -%}
        <div class="pi-rental-form__success" role="status" tabindex="-1" autofocus>
          <h3 class="pi-rental-form__success-heading">Transfer request received.</h3>
          <p>We'll reach out shortly with next steps. Please do not have your firearm shipped until you've heard back from us.</p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="pi-rental-form__error" role="alert" tabindex="-1" autofocus>
            <p>There was a problem submitting your request:</p>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="pi-rental-form__grid">

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Your Information</legend>
            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="ff-name">Name <span aria-hidden="true">*</span></label>
                <input type="text" id="ff-name" name="contact[Name]" required autocomplete="name">
              </div>
              <div class="pi-rental-form__field">
                <label for="ff-phone">Phone <span aria-hidden="true">*</span></label>
                <input type="tel" id="ff-phone" name="contact[Phone]" required autocomplete="tel">
              </div>
            </div>
            <div class="pi-rental-form__field">
              <label for="ff-email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="ff-email" name="contact[email]" required autocomplete="email">
            </div>
          </div>

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Sending Dealer</legend>
            <div class="pi-rental-form__field">
              <label for="ff-dealer-name">Dealer / shop name <span aria-hidden="true">*</span></label>
              <input type="text" id="ff-dealer-name" name="contact[Sending Dealer Name]" required>
            </div>
            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="ff-dealer-email">Dealer email</label>
                <input type="email" id="ff-dealer-email" name="contact[Sending Dealer Email]">
              </div>
              <div class="pi-rental-form__field">
                <label for="ff-dealer-ffl">Dealer FFL #</label>
                <input type="text" id="ff-dealer-ffl" name="contact[Sending Dealer FFL]">
              </div>
            </div>
          </div>

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Item Information</legend>
            <div class="pi-rental-form__field">
              <label for="ff-item">Item description <span aria-hidden="true">*</span></label>
              <input type="text" id="ff-item" name="contact[Item Description]" required placeholder="Make, model, caliber">
            </div>
            <div class="pi-rental-form__field">
              <label for="ff-serial">Serial number (if known)</label>
              <input type="text" id="ff-serial" name="contact[Serial Number]">
            </div>
          </div>

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">What do you need from us?</legend>
            <div class="pi-rental-form__radio-group" role="radiogroup" aria-label="Transfer action">
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Action]" value="Send PI Outdoors FFL to my dealer" required>
                <span>Send PI Outdoors' FFL to my dealer</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Action]" value="I'll forward PI's FFL to my dealer">
                <span>I'll forward PI's FFL to my dealer myself</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Action]" value="Not sure / questions">
                <span>Not sure — I have questions</span>
              </label>
            </div>
          </div>

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Additional Comments</legend>
            <div class="pi-rental-form__field">
              <label for="ff-notes" class="visually-hidden">Notes</label>
              <textarea id="ff-notes" name="contact[Notes]" rows="5" placeholder="Anything else we should know?"></textarea>
            </div>
          </div>

        </div>

        <div class="pi-rental-form__submit">
          <button type="submit" class="pi-btn pi-btn--primary">Submit Transfer Request</button>
          <p class="pi-rental-form__disclaimer">
            We'll respond within 1–2 business days. Do not ship a firearm before we confirm.
          </p>
        </div>

      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "PI FFL Transfer Form",
  "tag": "section",
  "class": "pi-rental-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "FFL Transfers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FFL Transfer Request"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Intro text",
      "default": "<p>Buying a firearm from another dealer? They'll need to ship it to a licensed FFL holder for pickup — that's us. Fill out the form below and we'll coordinate the transfer.</p>"
    },
    {
      "type": "header",
      "content": "Resource Links"
    },
    {
      "type": "checkbox",
      "id": "show_resource_links",
      "label": "Show regulation links",
      "default": true
    },
    {
      "type": "url",
      "id": "dnr_link",
      "label": "SC DNR hunting regulations URL"
    },
    {
      "type": "url",
      "id": "atf_link",
      "label": "ATF transfer information URL"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "ffl-transfer-form"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "default": "warm-white",
      "options": [
        { "value": "warm-white", "label": "Warm White" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "deep-blue", "label": "Deep Blue" },
        { "value": "midnight", "label": "Midnight" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI FFL Transfer Form",
      "category": "PI Outdoors"
    }
  ]
}
{% endschema %}
