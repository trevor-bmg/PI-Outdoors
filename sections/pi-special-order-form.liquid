{{ 'pi-base.css' | asset_url | stylesheet_tag }}
{{ 'section-pi-rental-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pi-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bg = section.settings.background_color
  assign is_dark = false
  if bg == 'deep-blue' or bg == 'midnight'
    assign is_dark = true
  endif
-%}

<section
  class="pi-section pi-rental-form-section pi-rental-form-section--bg-{{ bg }}{% if is_dark %} pi-rental-form-section--dark{% endif %}"
  id="{{ section.settings.anchor_id | default: 'special-order-form' }}"
>
  <div class="pi-section__inner pi-section__inner--narrow">

    {%- if section.settings.label != blank -%}
      <span class="pi-label pi-reveal">{{ section.settings.label }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pi-heading pi-heading--h2 pi-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.label != blank -%}
      <hr class="pi-divider pi-reveal">
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="pi-body pi-rental-form__intro pi-reveal">{{ section.settings.body_text }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'PiSpecialOrderForm', class: 'pi-rental-form pi-reveal' -%}
      <input type="hidden" name="contact[Form Type]" value="Special Order Request">

      {%- if form.posted_successfully? -%}
        <div class="pi-rental-form__success" role="status" tabindex="-1" autofocus>
          <h3 class="pi-rental-form__success-heading">Special order request received.</h3>
          <p>We'll check availability and pricing and follow up shortly.</p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="pi-rental-form__error" role="alert" tabindex="-1" autofocus>
            <p>There was a problem submitting your request:</p>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="pi-rental-form__grid">

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Your Information</legend>
            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="so-name">Name <span aria-hidden="true">*</span></label>
                <input type="text" id="so-name" name="contact[Name]" required autocomplete="name">
              </div>
              <div class="pi-rental-form__field">
                <label for="so-phone">Phone <span aria-hidden="true">*</span></label>
                <input type="tel" id="so-phone" name="contact[Phone]" required autocomplete="tel">
              </div>
            </div>
            <div class="pi-rental-form__field">
              <label for="so-email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="so-email" name="contact[email]" required autocomplete="email">
            </div>
          </div>

          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Item Request</legend>

            <div class="pi-rental-form__field">
              <label for="so-category">Category <span aria-hidden="true">*</span></label>
              <select id="so-category" name="contact[Category]" required>
                <option value="">Select a category…</option>
                <option value="Rod">Rod</option>
                <option value="Reel">Reel</option>
                <option value="Tackle">Tackle</option>
                <option value="Apparel">Apparel</option>
                <option value="Hunting Gear">Hunting Gear</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="so-brand">Brand</label>
                <input type="text" id="so-brand" name="contact[Brand]">
              </div>
              <div class="pi-rental-form__field">
                <label for="so-model">Model / SKU</label>
                <input type="text" id="so-model" name="contact[Model or SKU]">
              </div>
            </div>

            <div class="pi-rental-form__field">
              <label for="so-details">Details / specs <span aria-hidden="true">*</span></label>
              <textarea id="so-details" name="contact[Details]" rows="5" required placeholder="Length, action, line weight, color, size, quantity, etc."></textarea>
            </div>
          </div>

        </div>

        <div class="pi-rental-form__submit">
          <button type="submit" class="pi-btn pi-btn--primary">Submit Special Order Request</button>
          <p class="pi-rental-form__disclaimer">
            We'll confirm availability and price before placing the order.
          </p>
        </div>

      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "PI Special Order Form",
  "tag": "section",
  "class": "pi-rental-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Special Order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request a Special Order"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Intro text",
      "default": "<p>Looking for something specific? Tell us what you need and we'll see if we can get it. Rods, reels, tackle, hunting gear — if it's out there, we can usually source it.</p>"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "special-order-form"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "default": "warm-white",
      "options": [
        { "value": "warm-white", "label": "Warm White" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "deep-blue", "label": "Deep Blue" },
        { "value": "midnight", "label": "Midnight" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Special Order Form",
      "category": "PI Outdoors"
    }
  ]
}
{% endschema %}
