{{ 'pi-base.css' | asset_url | stylesheet_tag }}
{{ 'section-pi-rental-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pi-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bg = section.settings.background_color
  assign is_dark = false
  if bg == 'deep-blue' or bg == 'midnight'
    assign is_dark = true
  endif
-%}

<section
  class="pi-section pi-rental-form-section pi-rental-form-section--bg-{{ bg }}{% if is_dark %} pi-rental-form-section--dark{% endif %}"
  id="{{ section.settings.anchor_id | default: 'reservation-form' }}"
>
  <div class="pi-section__inner pi-section__inner--narrow">

    {%- if section.settings.label != blank -%}
      <span class="pi-label pi-reveal">{{ section.settings.label }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pi-heading pi-heading--h2 pi-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.label != blank -%}
      <hr class="pi-divider pi-reveal">
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="pi-body pi-rental-form__intro pi-reveal">{{ section.settings.body_text }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'PiRentalForm', class: 'pi-rental-form pi-reveal' -%}
      <input type="hidden" name="contact[Form Type]" value="Boat Rental Reservation">

      {%- if form.posted_successfully? -%}
        <div class="pi-rental-form__success" role="status" tabindex="-1" autofocus>
          <h3 class="pi-rental-form__success-heading">Reservation request received.</h3>
          <p>We'll be in touch shortly to confirm dates and details. For urgent requests, give us a call.</p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="pi-rental-form__error" role="alert" tabindex="-1" autofocus>
            <p>There was a problem submitting your request:</p>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="pi-rental-form__grid">

          {%- comment -%} Contact info {%- endcomment -%}
          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Your Information</legend>

            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="rf-name">Name <span aria-hidden="true">*</span></label>
                <input type="text" id="rf-name" name="contact[Name]" required autocomplete="name">
              </div>
              <div class="pi-rental-form__field">
                <label for="rf-phone">Cell phone <span aria-hidden="true">*</span></label>
                <input type="tel" id="rf-phone" name="contact[Phone]" required autocomplete="tel">
              </div>
            </div>

            <div class="pi-rental-form__field">
              <label for="rf-email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="rf-email" name="contact[email]" required autocomplete="email">
            </div>

            <div class="pi-rental-form__field">
              <label for="rf-primary-address">Primary address</label>
              <input type="text" id="rf-primary-address" name="contact[Primary Address]" autocomplete="street-address">
            </div>

            <div class="pi-rental-form__field">
              <label for="rf-rental-address">Rental address</label>
              <input type="text" id="rf-rental-address" name="contact[Rental Address]">
              <small class="pi-rental-form__hint">Where the boat will be used or delivered.</small>
            </div>
          </div>

          {%- comment -%} Dates {%- endcomment -%}
          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Reservation Dates</legend>

            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="rf-start">Start date <span aria-hidden="true">*</span></label>
                <input type="date" id="rf-start" name="contact[Start Date]" required>
              </div>
              <div class="pi-rental-form__field">
                <label for="rf-end">End date <span aria-hidden="true">*</span></label>
                <input type="date" id="rf-end" name="contact[End Date]" required>
              </div>
            </div>
            <small class="pi-rental-form__hint">3-day minimum on all deliveries. No deliveries to DeBordieu.</small>
          </div>

          {%- comment -%} Delivery {%- endcomment -%}
          <div class="pi-rental-form__fieldset" data-rf-delivery>
            <legend class="pi-rental-form__legend">Delivery</legend>

            <div class="pi-rental-form__radio-group" role="radiogroup" aria-label="Delivery method">
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Delivery Method]" value="Client Pickup" required data-rf-delivery-option="pickup">
                <span>Client pickup</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Delivery Method]" value="Landing Delivery ($30)" data-rf-delivery-option="landing">
                <span>Landing delivery — $30</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Delivery Method]" value="Dock Delivery ($75)" data-rf-delivery-option="dock">
                <span>Dock delivery — $75</span>
              </label>
            </div>

            <div class="pi-rental-form__field" data-rf-landing hidden>
              <label for="rf-landing">Boat landing</label>
              <select id="rf-landing" name="contact[Boat Landing]">
                <option value="">Select a landing…</option>
                <option value="Dawson">Dawson</option>
                <option value="Crocker">Crocker</option>
                <option value="Pritchard">Pritchard</option>
                <option value="Sundial">Sundial</option>
                <option value="Inlet Point">Inlet Point</option>
              </select>
            </div>
          </div>

          {%- comment -%} Dock type (deposit) {%- endcomment -%}
          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Dock Type (determines deposit)</legend>

            <div class="pi-rental-form__radio-group" role="radiogroup" aria-label="Dock type">
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Dock Type]" value="Fixed Dock ($1000 deposit)" required>
                <span>Fixed dock — $1,000 deposit</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Dock Type]" value="Floating Dock ($500 deposit)">
                <span>Floating dock — $500 deposit</span>
              </label>
              <label class="pi-rental-form__radio">
                <input type="radio" name="contact[Dock Type]" value="No Dock / Trailering ($500 deposit)">
                <span>No dock / trailering — $500 deposit</span>
              </label>
            </div>
          </div>

          {%- comment -%} PFDs {%- endcomment -%}
          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Life Jackets (PFDs)</legend>
            <div class="pi-rental-form__row">
              <div class="pi-rental-form__field">
                <label for="rf-pfd-adult">Adult</label>
                <input type="number" id="rf-pfd-adult" name="contact[PFDs Adult]" min="0" max="20" value="0">
              </div>
              <div class="pi-rental-form__field">
                <label for="rf-pfd-youth">Youth</label>
                <input type="number" id="rf-pfd-youth" name="contact[PFDs Youth]" min="0" max="20" value="0">
              </div>
            </div>
          </div>

          {%- comment -%} Notes {%- endcomment -%}
          <div class="pi-rental-form__fieldset">
            <legend class="pi-rental-form__legend">Additional Comments</legend>
            <div class="pi-rental-form__field">
              <label for="rf-notes" class="visually-hidden">Special notes</label>
              <textarea id="rf-notes" name="contact[Special Notes]" rows="5" placeholder="Anything else we should know?"></textarea>
            </div>
          </div>

        </div>

        <div class="pi-rental-form__submit">
          <button type="submit" class="pi-btn pi-btn--primary">Submit Reservation Request</button>
          <p class="pi-rental-form__disclaimer">
            Submitting this form sends a request — it does not confirm a reservation. We'll follow up by phone or email.
          </p>
        </div>

      {%- endif -%}
    {%- endform -%}

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('{{ section.settings.anchor_id | default: 'reservation-form' }}');
    if (!section) return;
    var landingWrap = section.querySelector('[data-rf-landing]');
    var landingSelect = landingWrap ? landingWrap.querySelector('select') : null;
    var radios = section.querySelectorAll('[data-rf-delivery-option]');

    function update() {
      var selected = section.querySelector('[data-rf-delivery-option]:checked');
      var isLanding = selected && selected.getAttribute('data-rf-delivery-option') === 'landing';
      if (!landingWrap) return;
      if (isLanding) {
        landingWrap.hidden = false;
        if (landingSelect) landingSelect.required = true;
      } else {
        landingWrap.hidden = true;
        if (landingSelect) {
          landingSelect.required = false;
          landingSelect.value = '';
        }
      }
    }

    radios.forEach(function (r) { r.addEventListener('change', update); });
    update();
  })();
</script>

{% schema %}
{
  "name": "PI Rental Form",
  "tag": "section",
  "class": "pi-rental-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Reserve a Boat"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Jon Boat Reservation Request"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Intro text",
      "default": "<p>Fill out the form below to request a reservation. We'll follow up by phone or email to confirm.</p>"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Used for in-page links (e.g. #reservation-form).",
      "default": "reservation-form"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Background color",
      "default": "warm-white",
      "options": [
        { "value": "warm-white", "label": "Warm White" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "deep-blue", "label": "Deep Blue" },
        { "value": "midnight", "label": "Midnight" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PI Rental Form",
      "category": "PI Outdoors"
    }
  ]
}
{% endschema %}
